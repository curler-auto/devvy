import React, { useState, useEffect } from 'react';
import Editor from '@monaco-editor/react';
import { Code, Copy, Check, AlertCircle, RefreshCw, Settings, Plus, Trash2, FileText, X, ChevronDown, ChevronRight } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { toast } from 'sonner';
import { faker } from '@faker-js/faker';

/**
 * Random JSON Generator Tool
 * Generate random JSON data with customizable structure and schema builder
 * Uses Faker.js for realistic data generation
 */
function RandomJSONGenerator({ tab, tabs, setTabs, editorTheme = 'vs-dark' }) {
  const [generatedJSON, setGeneratedJSON] = useState(tab.data?.output || '');
  const [copied, setCopied] = useState(false);
  const [activeTab, setActiveTab] = useState(tab.data?.activeTab || 'config');
  const [showResultsSidebar, setShowResultsSidebar] = useState(false);
  const [blinkResults, setBlinkResults] = useState(false);
  
  // Config-based generation settings
  const [config, setConfig] = useState(tab.data?.config || {
    count: 1,
    depth: 3,
    arrayLength: 5,
  });
  
  // Schema-based generation
  const [schema, setSchema] = useState(tab.data?.schema || [
    { id: 1, name: 'id', type: 'number', fakerMethod: 'number.int', arrayLength: 1, isArray: false, expanded: false }
  ]);
  const [nextFieldId, setNextFieldId] = useState(2);

  // Update tab data when settings or output change
  useEffect(() => {
    const updatedTabs = tabs.map(t => 
      t.tabId === tab.tabId 
        ? { ...t, data: { 
            output: generatedJSON,
            settings
          } }
        : t
    );
    setTabs(updatedTabs);
  }, [generatedJSON, settings]);

  // Generate random JSON
  const generateJSON = () => {
    try {
      // Update seed for new random values
      setSettings(prev => ({ ...prev, seed: Math.floor(Math.random() * 1000000) }));
      
      // Generate JSON based on settings
      const result = generateRandomJSON(settings);
      
      // Format and set output
      const formattedResult = JSON.stringify(result, null, 2);
      setGeneratedJSON(formattedResult);
      
      toast.success('Random JSON generated successfully');
    } catch (err) {
      console.error('Generation error:', err);
      toast.error(`Generation error: ${err.message}`);
    }
  };

  // Generate random JSON based on settings
  const generateRandomJSON = (config) => {
    // Seed random number generator
    const random = seedRandom(config.seed);
    
    // Generate based on selected type
    switch (config.type) {
      case 'object':
        return generateRandomObject(config, 0, random);
      case 'array':
        return generateRandomArray(config, 0, random);
      case 'mixed':
        return random() > 0.5 
          ? generateRandomObject(config, 0, random) 
          : generateRandomArray(config, 0, random);
      default:
        return generateRandomObject(config, 0, random);
    }
  };

  // Generate random object
  const generateRandomObject = (config, depth, random) => {
    const result = {};
    
    // Determine number of properties
    const numProps = Math.max(1, Math.floor(random() * config.breadth) + 1);
    
    for (let i = 0; i < numProps; i++) {
      const key = `key_${i + 1}`;
      result[key] = generateRandomValue(config, depth, random);
    }
    
    return result;
  };

  // Generate random array
  const generateRandomArray = (config, depth, random) => {
    const result = [];
    
    // Determine array length
    const length = Math.max(1, Math.floor(random() * config.arrayLength) + 1);
    
    for (let i = 0; i < length; i++) {
      result.push(generateRandomValue(config, depth, random));
    }
    
    return result;
  };

  // Generate random value
  const generateRandomValue = (config, depth, random) => {
    // Available value types based on settings
    const availableTypes = [];
    
    if (config.includeStrings) availableTypes.push('string');
    if (config.includeNumbers) availableTypes.push('number');
    if (config.includeBooleans) availableTypes.push('boolean');
    if (config.includeNulls) availableTypes.push('null');
    
    // Only include objects and arrays if we haven't reached max depth
    if (depth < config.depth) {
      if (config.includeObjects) availableTypes.push('object');
      if (config.includeArrays) availableTypes.push('array');
    }
    
    // Default to string if no types are selected
    if (availableTypes.length === 0) {
      availableTypes.push('string');
    }
    
    // Select random type
    const type = availableTypes[Math.floor(random() * availableTypes.length)];
    
    // Generate value based on type
    switch (type) {
      case 'string':
        return generateRandomString(random);
      case 'number':
        return generateRandomNumber(random);
      case 'boolean':
        return random() > 0.5;
      case 'null':
        return null;
      case 'object':
        return generateRandomObject(config, depth + 1, random);
      case 'array':
        return generateRandomArray(config, depth + 1, random);
      default:
        return generateRandomString(random);
    }
  };

  // Generate random string
  const generateRandomString = (random) => {
    const templates = [
      'Lorem ipsum',
      'Hello world',
      'Random text',
      'Sample data',
      'Test string',
      'Example value',
      'JSON generator',
      'Devvy Studio',
      'Generated content',
      'Placeholder text'
    ];
    
    return templates[Math.floor(random() * templates.length)];
  };

  // Generate random number
  const generateRandomNumber = (random) => {
    // 20% chance of decimal
    if (random() > 0.8) {
      return Math.round(random() * 1000) / 10;
    }
    
    return Math.floor(random() * 100);
  };

  // Simple seeded random number generator
  const seedRandom = (seed) => {
    return function() {
      seed = (seed * 9301 + 49297) % 233280;
      return seed / 233280;
    };
  };

  // Update a setting value
  const updateSetting = (key, value) => {
    setSettings(prev => ({ ...prev, [key]: value }));
  };

  const copyToClipboard = async () => {
    try {
      await navigator.clipboard.writeText(generatedJSON);
      setCopied(true);
      toast.success('Copied to clipboard!');
      setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      console.error('Copy error:', err);
      toast.error('Failed to copy');
    }
  };

  return (
    <div className="random-json-generator-tool" data-testid="random-json-generator">
      <div className="flex flex-col h-full">
        {/* Controls */}
        <div className="mb-4 flex justify-between items-center">
          <div className="flex items-center gap-2">
            <Button 
              onClick={() => setShowSettings(!showSettings)} 
              size="sm"
              variant={showSettings ? "default" : "outline"}
            >
              <Settings className="w-4 h-4 mr-2" />
              {showSettings ? 'Hide Settings' : 'Show Settings'}
            </Button>
          </div>
          
          <div className="flex items-center gap-2">
            <Button 
              onClick={generateJSON} 
              size="sm"
            >
              <RefreshCw className="w-4 h-4 mr-2" />
              Generate Random JSON
            </Button>
            
            <Button 
              onClick={copyToClipboard} 
              size="sm"
              variant="outline"
              disabled={!generatedJSON}
            >
              {copied ? (
                <><Check className="w-4 h-4 mr-2" /> Copied</>
              ) : (
                <><Copy className="w-4 h-4 mr-2" /> Copy</>
              )}
            </Button>
          </div>
        </div>
        
        {/* Settings Panel */}
        {showSettings && (
          <div className="mb-4 p-4 border border-[var(--border-primary)] rounded-md bg-[var(--bg-tertiary)]">
            <h3 className="text-base font-medium mb-3">Generator Settings</h3>
            
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {/* Root Type */}
              <div>
                <label className="block text-sm font-medium mb-1">Root Type</label>
                <select 
                  value={settings.type}
                  onChange={(e) => updateSetting('type', e.target.value)}
                  className="w-full px-3 py-2 border rounded-md bg-[var(--bg-secondary)] border-[var(--border-primary)] text-[var(--text-primary)]"
                >
                  <option value="object">Object</option>
                  <option value="array">Array</option>
                  <option value="mixed">Mixed (Random)</option>
                </select>
              </div>
              
              {/* Depth */}
              <div>
                <label className="block text-sm font-medium mb-1">
                  Max Depth: {settings.depth}
                </label>
                <input 
                  type="range"
                  min="1"
                  max="5"
                  value={settings.depth}
                  onChange={(e) => updateSetting('depth', parseInt(e.target.value))}
                  className="w-full"
                />
              </div>
              
              {/* Breadth */}
              <div>
                <label className="block text-sm font-medium mb-1">
                  Max Properties: {settings.breadth}
                </label>
                <input 
                  type="range"
                  min="1"
                  max="10"
                  value={settings.breadth}
                  onChange={(e) => updateSetting('breadth', parseInt(e.target.value))}
                  className="w-full"
                />
              </div>
              
              {/* Array Length */}
              <div>
                <label className="block text-sm font-medium mb-1">
                  Max Array Length: {settings.arrayLength}
                </label>
                <input 
                  type="range"
                  min="1"
                  max="20"
                  value={settings.arrayLength}
                  onChange={(e) => updateSetting('arrayLength', parseInt(e.target.value))}
                  className="w-full"
                />
              </div>
              
              {/* Value Types */}
              <div className="col-span-1 md:col-span-2">
                <label className="block text-sm font-medium mb-1">Include Value Types</label>
                <div className="flex flex-wrap gap-3">
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeStrings}
                      onChange={(e) => updateSetting('includeStrings', e.target.checked)}
                    />
                    <span className="text-sm">Strings</span>
                  </label>
                  
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeNumbers}
                      onChange={(e) => updateSetting('includeNumbers', e.target.checked)}
                    />
                    <span className="text-sm">Numbers</span>
                  </label>
                  
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeBooleans}
                      onChange={(e) => updateSetting('includeBooleans', e.target.checked)}
                    />
                    <span className="text-sm">Booleans</span>
                  </label>
                  
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeNulls}
                      onChange={(e) => updateSetting('includeNulls', e.target.checked)}
                    />
                    <span className="text-sm">Nulls</span>
                  </label>
                  
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeArrays}
                      onChange={(e) => updateSetting('includeArrays', e.target.checked)}
                    />
                    <span className="text-sm">Arrays</span>
                  </label>
                  
                  <label className="flex items-center gap-1">
                    <input 
                      type="checkbox"
                      checked={settings.includeObjects}
                      onChange={(e) => updateSetting('includeObjects', e.target.checked)}
                    />
                    <span className="text-sm">Objects</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        )}
        
        {/* Generated JSON */}
        <div className="flex-1">
          <div className="panel-header">
            <h3>Generated JSON</h3>
          </div>
          <div className="editor-container">
            <Editor
              height="100%"
              defaultLanguage="json"
              theme={editorTheme}
              value={generatedJSON}
              options={{
                minimap: { enabled: false },
                fontSize: 12,
                lineNumbers: 'on',
                scrollBeyondLastLine: false,
                readOnly: true,
                automaticLayout: true,
                tabSize: 2,
              }}
            />
          </div>
        </div>
      </div>
    </div>
  );
}

// Tool metadata
RandomJSONGenerator.metadata = {
  id: 'random-json-generator',
  name: 'Random JSON Generator',
  description: 'Generate random JSON data with customizable structure',
  category: 'json',
  requiresBackend: false, // Client-side implementation
};

export default RandomJSONGenerator;
