{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Devvy Studio",
  "version": "0.1.0",
  "identifier": "com.devvy.studio",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "REACT_APP_BACKEND_URL=http://127.0.0.1:8001 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Devvy Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "entitlements": "./entitlements.plist"
    }
  }
}
